# Frigo Cloudflare Worker Environment Variables Example
ENVIRONMENT=development
APP_URL=http://localhost:5173

# AI Mock Mode (set to "true" to test without third-party API keys)
AI_MOCK_MODE=true

# AI Gateway URL (Optional Cloudflare AI Gateway endpoint)
AI_GATEWAY_URL=

# Primary Vision Provider: Qwen (Alibaba Cloud / DashScope)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_REQUEST_TIMEOUT_MS=60000

# Qwen task runtime governance (production uses AI_QWEN_ONLY=true)
AI_ENABLED=true
AI_QWEN_ONLY=true
AI_ALLOW_REASONING_MODEL=false
AI_ALLOW_JUDGE_MODEL=false
AI_MAX_CALLS_PER_OPERATION=3
AI_MAX_TOTAL_TOKENS=16000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=2048
AI_SHADOW_CANARY_PERCENT=0
AI_MODEL_FAST=qwen3.7-flash-2026-07-15
AI_MODEL_FAST_CANARY=qwen3.7-flash
AI_MODEL_MULTIMODAL=qwen3.8-flash
AI_MODEL_OCR=qwen-vl-ocr
AI_MODEL_REASONING=qwen3.8-27b
AI_MODEL_JUDGE=qwen3.8-max-0902

# Fallback Vision & Text Provider: GLM / Z.ai (Zhipu AI)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_FALLBACK_ENABLED=false

# Primary Recipe Ranking & Reasoning: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FALLBACK_ENABLED=false

# Legacy Groq adapter (disabled when Qwen is configured)
GROQ_FALLBACK_ENABLED=false

# Auth Adapters
JWT_SECRET=
# Independent random secret for OTP HMACs; use a stable per-environment value.
OTP_HASH_SECRET=
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Security: Cloudflare Turnstile
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
